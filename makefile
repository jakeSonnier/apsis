CXX = g++
CXXFLAGS = -std=c++20 -Wall -Wextra -Iinclude
BUILD_DIR = build
TARGET = $(BUILD_DIR)/apsis

# Find all C++ source files in src/
SOURCES = $(wildcard src/*.C)

# Map src/file.cpp to build/src/file.o
OBJECTS = $(patsubst src/%.C,$(BUILD_DIR)/src/%.o,$(SOURCES))

# Dependency files generated by the compiler
DEPS = $(OBJECTS:.o=.d)

# Default target
.PHONY: all clean
all: $(TARGET)

# Link all object files into the executable
$(TARGET): $(OBJECTS)
	$(CXX) $(OBJECTS) -o $@

# Compile each source file separately
$(BUILD_DIR)/src/%.o: src/%.C
	mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

# Read automatically generated header dependencies
-include $(DEPS)

# Remove generated files
clean:
	rm -rf $(BUILD_DIR)
